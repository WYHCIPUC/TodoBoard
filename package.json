{
  "name": "linggankanban",
  "version": "2.0.0-beta.2",
  "private": true,
  "description": "灵感来袭：本地优先的链接收集、研究与待办看板",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "doctor": "node scripts/doctor.js",
    "package:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-release.ps1",
    "package:portable": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-portable.ps1",
    "package:exe": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-executable.ps1",
    "test": "node scripts/run-tests.js",
    "test:integration": "node scripts/run-scraper-tests.js",
    "check": "node --check server.js && node --check board.js && node scripts/run-tests.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "keywords": [
    "kanban",
    "bookmark",
    "markdown",
    "local-first",
    "zero-config"
  ],
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "cheerio": "^1.0.0",
    "dingtalk-stream-sdk-nodejs": "^2.0.4",
    "linkedom": "^0.18.13",
    "turndown": "^7.2.0"
  }
}
