{
  "name": "linggankanban",
  "version": "2.2.0",
  "private": true,
  "description": "灵感工作台：本地优先的链接收集、研究与决策工作台",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "doctor": "node scripts/doctor.js",
    "package:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-release.ps1",
    "package:portable": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-portable.ps1",
    "package:exe": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-executable.ps1",
    "build:demo": "node scripts/build-demo.js",
    "test": "node scripts/run-tests.js",
    "test:scrapers:fixtures": "node scripts/run-tests.js --test-dir lib/scraper",
    "test:e2e": "node e2e/browser-smoke.js",
    "test:launcher": "node scripts/run-tests.js --test scripts/build-executable.test.js",
    "test:integration": "node scripts/run-scraper-tests.js",
    "coverage": "c8 --include=scripts/run-tests.js --include=lib/backup.js --include=lib/backup-format.js --include=lib/backup-transaction.js --include=lib/maintenance.js --include=lib/archive-content.js --include=lib/archive-quality.js --include=lib/archive-integrity.js --include=lib/attention.js --include=lib/schema.js --include=lib/store.js --include=lib/archive.js --include=lib/archive-queue.js --include=lib/capture.js --include=lib/search.js --include=lib/brainstorm.js node scripts/run-tests.js",
    "check": "node --check server.js && node --check board.js && node scripts/run-tests.js"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "keywords": [
    "kanban",
    "bookmark",
    "markdown",
    "local-first",
    "zero-config"
  ],
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "cheerio": "^1.0.0",
    "dingtalk-stream-sdk-nodejs": "^2.0.4",
    "linkedom": "^0.18.13",
    "turndown": "^7.2.0"
  },
  "devDependencies": {
    "c8": "^10.1.3"
  }
}
